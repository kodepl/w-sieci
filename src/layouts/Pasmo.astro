---
import "../styles/global.css";
import { canonicalHref, formatWhen } from "../lib/pasmo";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  published?: Date;
  activeCat?: string;
}

const { title, description, ogImage, type = "website", published, activeCat } = Astro.props;
const pageTitle = title.includes("W Sieci") ? title : `${title} · W Sieci`;
const canonical = canonicalHref(Astro.url.pathname, Astro.site);
const image =
  ogImage ||
  "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1600&q=80";
const todayLabel = formatWhen(new Date());
const cats = [
  { href: "/pasmo/", label: "Wszystkie" },
  { href: "/pasmo/", label: "Nawyki" },
  { href: "/pasmo/", label: "Poczta" },
  { href: "/pasmo/", label: "Bezpieczeństwo" },
  { href: "/pasmo/", label: "Praca" },
  { href: "/pasmo/", label: "Telefon" },
  { href: "/pasmo/", label: "Ekran" },
  { href: "/o-pasmie/", label: "O portalu" },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="W Sieci" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      published && (
        <meta property="article:published_time" content={published.toISOString()} />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600;6..72,700&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": type === "article" ? "NewsArticle" : "WebSite",
        name: pageTitle,
        headline: title,
        description,
        url: canonical,
        inLanguage: "pl-PL",
        image,
        publisher: {
          "@type": "NewsMediaOrganization",
          name: "W Sieci",
          url: "https://www.w-sieci.info.pl/",
        },
        ...(published
          ? {
              datePublished: published.toISOString(),
              author: { "@type": "Person", name: "Nora Belka" },
            }
          : {}),
      })}
    />
  </head>
  <body>
    <div class="ws-topbar">
      <div class="ws-topbar-inner">
        <span>Portal o byciu online · Polska</span>
        <nav aria-label="Szybkie">
          <a href="/pasmo/">Archiwum</a>
          {" · "}
          <a href="/list/">Kontakt</a>
          {" · "}
          <a href="/prywatnosc/">Prywatność</a>
        </nav>
      </div>
    </div>

    <header class="ws-mast">
      <div class="ws-mast-inner">
        <a class="ws-brand" href="/" aria-label="W Sieci, strona główna">
          <span class="ws-logo">W <span>Sieci</span></span>
          <p class="ws-claim">
            Teksty o nawykach, narzędziach i szumie, który wchodzi w zwykły dzień.
          </p>
        </a>
        <div class="ws-mast-meta">
          <strong>{todayLabel}</strong>
          <span>wydanie online</span>
        </div>
      </div>
    </header>

    <nav class="ws-cats" aria-label="Działy">
      <div class="ws-cats-inner">
        {
          cats.map((cat) => (
            <a href={cat.href} aria-current={activeCat === cat.label ? "page" : undefined}>
              {cat.label}
            </a>
          ))
        }
      </div>
    </nav>

    <main id="tresc" class="ws-frame">
      <slot />
    </main>

    <footer class="ws-foot">
      <div class="ws-foot-inner">
        <div>
          <strong>W Sieci</strong>
          <p>
            Niezależny portal o życiu online. Redakcja: Nora Belka. Materiał informacyjny, nie
            poradnik sprzedażowy.
          </p>
        </div>
        <div>
          <strong>Nawigacja</strong>
          <ul>
            <li><a href="/">Start</a></li>
            <li><a href="/pasmo/">Archiwum pasma</a></li>
            <li><a href="/o-pasmie/">O portalu</a></li>
            <li><a href="/list/">Napisz</a></li>
          </ul>
        </div>
        <div>
          <strong>Informacje</strong>
          <ul>
            <li><a href="/prywatnosc/">Prywatność</a></li>
            <li>w-sieci.info.pl</li>
          </ul>
        </div>
      </div>
    </footer>
    <script
      defer
      src="https://umami-pink-phi.vercel.app/script.js"
      data-website-id="157f6fbf-ba14-4fde-a5a6-e86bb28e4cf1"
      data-domains="w-sieci.info.pl,www.w-sieci.info.pl"></script>
  </body>
</html>
