---
import { getCollection } from "astro:content";
import Pasmo from "../layouts/Pasmo.astro";
import { byNewest, formatWhen, isoDay } from "../lib/pasmo";

const posts = byNewest(await getCollection("pasmo"));
const lead = posts[0];
const rest = posts.slice(1);
---

<Pasmo
  title="W Sieci"
  description="Portal o byciu online. Pasmo tekstów o nawykach, narzędziach i szumie, który wchodzi w dzień."
  ogImage={lead?.data.image}
>
  {
    lead && (
      <section class="ws-lead" aria-labelledby="ws-lead-title">
        <p class="ws-kicker">Pasmo {lead.data.numer} · lead</p>
        <h1 id="ws-lead-title">{lead.data.title}</h1>
        <p>{lead.data.description}</p>
        <a href={`/pasmo/${lead.slug}/`}>Czytaj lead</a>
      </section>
    )
  }

  <h2 class="ws-band-title">Indeks pasma</h2>
  <ol class="ws-band">
    {
      rest.map((post) => (
        <li>
          <a href={`/pasmo/${post.slug}/`}>
            <span class="ws-num">{post.data.numer}</span>
            <span class="ws-band-name">{post.data.title}</span>
            <time class="ws-when" datetime={isoDay(post.data.pubDate)}>
              {formatWhen(post.data.pubDate)}
            </time>
          </a>
        </li>
      ))
    }
  </ol>
</Pasmo>
